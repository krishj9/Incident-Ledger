{
  "expo": {
    "name": "Incident Ledger — Staff",
    "slug": "incident-ledger-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "incident-ledger",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.incident-ledger.staff"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
