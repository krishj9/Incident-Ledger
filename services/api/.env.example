# Incident Ledger API — local development environment
# Copy to .env and fill in real values. Never commit .env.

# ── Demo guard ─────────────────────────────────────────────────────────────────
INCIDENT_LEDGER_DEMO_ONLY=true
INCIDENT_LEDGER_ALLOWED_CENTER_CODES=["DEMO-MGLC-01"]

# ── Database ───────────────────────────────────────────────────────────────────
INCIDENT_LEDGER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incident_ledger

# ── OIDC (Microsoft Entra) ─────────────────────────────────────────────────────
INCIDENT_LEDGER_OIDC_ISSUER=https://login.microsoftonline.com/<TENANT_ID>/v2.0
INCIDENT_LEDGER_OIDC_AUDIENCE=<APP_CLIENT_ID>
INCIDENT_LEDGER_OIDC_JWKS_URI=https://login.microsoftonline.com/<TENANT_ID>/discovery/v2.0/keys

# ── Local dev: bypass OIDC validation ─────────────────────────────────────────
INCIDENT_LEDGER_MOCK_AUTH=true

# ── CORS ───────────────────────────────────────────────────────────────────────
INCIDENT_LEDGER_CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000"]

# ── Logging ────────────────────────────────────────────────────────────────────
INCIDENT_LEDGER_LOG_LEVEL=INFO

# ── Google Cloud / Vertex AI ───────────────────────────────────────────────────
INCIDENT_LEDGER_GCP_PROJECT_ID=
INCIDENT_LEDGER_GEMINI_MODEL=gemini-2.5-flash
